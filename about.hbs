<!DOCTYPE html>
<!-- Generated by cargo-about from about.hbs (scripts/notices.sh, scripts/build-client.sh). -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>web-access: third-party licences</title>
<link rel="stylesheet" href="./app.css">
<script src="./theme.js"></script>
</head>
<body>
<main class="notices">
<h1>@TITLE@</h1>
<p class="note">@INTRO@ <a class="navlink" href="@OTHER_HREF@">@OTHER_LABEL@</a></p>
<h2>Licences</h2>
<ul class="notice-overview">
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<section class="card notice">
<h3 id="{{id}}">{{name}}</h3>
<p class="note">Used by:
{{#each used_by}}
<a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}}, {{/unless}}
{{/each}}
</p>
<pre class="notice-text">{{text}}</pre>
</section>
{{/each}}
</main>
</body>
</html>
