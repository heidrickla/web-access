<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI for the web-access proxy.

  MSI rather than a self-extracting exe because this is meant to be deployable the way an
  organisation already deploys things: GPO, SCCM or Intune, with a real uninstall and a real
  upgrade path. A script that copies files and calls sc.exe is not that.

  Build:  installer/build.ps1, which passes the version from Cargo.toml as ProductVersion.

  Public properties:
    REMOTE_ADDRESSES   who the firewall rule admits: "*" (default) or a comma-separated list of
                       addresses, ranges or subnets. Remembered, so an upgrade keeps it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef ProductVersion ?>
    <?error ProductVersion is not set; build with installer/build.ps1 ?>
  <?endif?>

  <Package Name="web-access proxy"
           Manufacturer="Lewis Heidrick"
           Version="$(var.ProductVersion)"
           UpgradeCode="7c4a1c6e-2f5b-4d8a-9e13-5b0a2d6f8c41"
           Scope="perMachine"
           Compressed="yes">

    <!-- The old version is removed after the new one is installed. Components with the same GUID
         (the config, the service, the data folder) are then shared and survive the removal, which
         the default schedule does not allow: it removed 0.2.0 first, and 0.2.0's own package deleted
         config.toml. A failure installing the new version rolls back with the old one still there. -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The firewall rule's remote addresses: given on the command line, else the value the last
         install recorded, else any. -->
    <Property Id="REMOTE_ADDRESSES" Secure="yes" />
    <Property Id="SAVED_REMOTE_ADDRESSES">
      <RegistrySearch Id="SavedRemoteAddresses" Root="HKLM" Key="Software\web-access"
                      Name="RemoteAddresses" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="REMOTE_ADDRESSES" Value="[SAVED_REMOTE_ADDRESSES]" After="AppSearch"
                 Sequence="both" Condition="NOT REMOTE_ADDRESSES AND SAVED_REMOTE_ADDRESSES" />
    <SetProperty Id="REMOTE_ADDRESSES" Value="*" After="SetREMOTE_ADDRESSES" Action="DefaultRemoteAddresses"
                 Sequence="both" Condition="NOT REMOTE_ADDRESSES" />

    <!-- The config and the database live outside the install directory, so an upgrade replaces
         the program and nothing an administrator wrote. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="web-access" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="web-access" />
    </StandardDirectory>

    <ComponentGroup Id="Payload">
      <!-- 32-bit, as 0.2.0 registered this GUID. A 64-bit component with the same GUID counts as
           installed elsewhere, so removing 0.2.0 after the upgrade deleted the new exe and its
           firewall rule. Shared, the old product's removal leaves both in place. -->
      <Component Id="ProxyExe" Directory="INSTALLFOLDER" Guid="a1d2f3b4-5c6d-4e7f-8a90-b1c2d3e4f501" Bitness="always32">
        <File Id="web_access_proxy.exe" Source="payload\web-access-proxy.exe" KeyPath="yes" />

        <!-- LocalService, not LocalSystem. The proxy opens sockets and reads and writes its data
             directory; directory binds use the signing-in user's own credentials or the configured
             service account, never the machine's identity. -->
        <ServiceInstall Id="ServiceInstall"
                        Name="WebAccessProxy"
                        DisplayName="web-access RDP proxy"
                        Description="Browser-based RDP gateway: signs users in against Active Directory, serves each user's server list, and relays RDP sessions to the servers assigned to them."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService"
                        Arguments="--service &quot;[DATAFOLDER]config.toml&quot;"
                        Vital="yes">
          <!-- Restarted a minute after the process ends unexpectedly; the failure count resets
               after a day. A start refused for a bad config or a port in use stops cleanly and
               stays stopped, with the reason in the log. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- Not started on a first install: the shipped config names example hosts, and a gateway
             should not run against a config nobody wrote. Start type is auto, so once an
             administrator configures and starts it, it survives reboots. An upgrade starts it
             again: see StartAfterUpgrade. -->
        <ServiceControl Id="ServiceControl"
                        Name="WebAccessProxy"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- Scoped to the program, not to a port: the listening port comes from config.toml, which
             an administrator edits after install. File= is what scopes it: without it the rule has
             no program and admits every port. The remote addresses come from REMOTE_ADDRESSES, any
             by default, since users reach the proxy from other subnets. -->
        <fw:FirewallException Id="InboundWebSocket"
                              Name="web-access proxy"
                              Description="Inbound connections to the web-access RDP proxy"
                              File="web_access_proxy.exe"
                              Profile="all"
                              Protocol="tcp"
                              IgnoreFailure="no">
          <fw:RemoteAddress Value="[REMOTE_ADDRESSES]" />
        </fw:FirewallException>
      </Component>

      <!-- Records REMOTE_ADDRESSES so the next install keeps it: an upgrade, or a reinstall after an
           uninstall (Permanent), as when going back to a previous version. -->
      <Component Id="Settings" Directory="INSTALLFOLDER" Guid="e5a6b7c8-9d0e-4f12-8a3b-4c5d6e7f8091"
                 Bitness="always64" Permanent="yes">
        <RegistryValue Root="HKLM" Key="Software\web-access" Name="RemoteAddresses"
                       Value="[REMOTE_ADDRESSES]" Type="string" KeyPath="yes" />
      </Component>

      <!-- An upgrade replaces the service, which leaves it stopped; this starts it again. Its start
           type is auto, so it would start at the next boot anyway. A first install has no
           WIX_UPGRADE_DETECTED and leaves it stopped. -->
      <Component Id="StartAfterUpgrade" Directory="INSTALLFOLDER" Guid="f6b7c8d9-0e1f-4a23-9b4c-5d6e7f809102"
                 Bitness="always64" Condition="WIX_UPGRADE_DETECTED">
        <RegistryValue Root="HKLM" Key="Software\web-access" Name="StartedAfterUpgrade"
                       Value="1" Type="integer" KeyPath="yes" />
        <!-- Wait="no": a start that fails (a config not yet edited) is in the service's log, and does
             not fail the upgrade. -->
        <ServiceControl Id="StartAfterUpgrade" Name="WebAccessProxy" Start="install" Wait="no" />
      </Component>

      <!-- The licence and the third-party notices, beside the binary; the proxy also serves the
           notices at /notices. -->
      <Component Id="Notices" Directory="INSTALLFOLDER" Guid="a7c8d9e0-1f2a-4b34-8c5d-6e7f80910213">
        <File Id="LICENSE.txt" Source="..\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        <File Id="notices.html" Source="..\web\notices.html" Name="notices.html" />
        <File Id="notices_client.html" Source="..\web\notices-client.html" Name="notices-client.html" />
      </Component>

      <!-- Permanent: uninstalling, and the uninstall of the old version inside an upgrade, leave
           the administrator's config in place. NeverOverwrite: installing never replaces an
           existing config with the example. -->
      <Component Id="ConfigFile" Directory="DATAFOLDER" Guid="b2e3a4c5-6d7e-4f80-9ab1-c2d3e4f50612"
                 NeverOverwrite="yes" Permanent="yes">
        <File Id="config.toml" Source="..\config.example.toml" Name="config.toml" KeyPath="yes" />
      </Component>

      <!-- The data directory holds the database, its backups and the certificates. Inheritance
           from ProgramData is cut: SYSTEM and Administrators have full control, the service account
           may modify, and nobody else has access. Permanent, so uninstalling leaves the data and
           its protection in place. Each install and upgrade applies this list again. -->
      <Component Id="DataFolderAcl" Directory="DATAFOLDER" Guid="c3f4b5d6-7e8f-4091-8bc2-d3e4f5061723"
                 Permanent="yes" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;LS)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="web-access proxy" Level="1">
      <ComponentGroupRef Id="Payload" />
    </Feature>

  </Package>
</Wix>
